# Standard PostgreSQL connection URI. Supabase PostgreSQL connection strings work here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: set true when your provider requires TLS and the connection URI does not enable it.
DATABASE_SSL=false
API_KEY=replace-with-a-long-random-assessment-key
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
